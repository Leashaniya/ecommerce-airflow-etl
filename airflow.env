# Source this file before running any airflow command:
#   source airflow.env

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-${(%):-%x}}")" && pwd)"

export AIRFLOW_HOME="$PROJECT_DIR/airflow_home"
export AIRFLOW__CORE__DAGS_FOLDER="$PROJECT_DIR/dags"
export AIRFLOW__CORE__LOAD_EXAMPLES=False

# Target database (local PostgreSQL from Postgres.app, no password).
export AIRFLOW_CONN_ECOMMERCE_DW="postgresql://$(whoami)@localhost:5432/ecommerce_dw"

source "$PROJECT_DIR/.venv/bin/activate"
